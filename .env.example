# Local development defaults (also hard-coded as fallbacks in src/lib/config.ts).
# App connects as a NON-superuser role so row-level security is always enforced.
DATABASE_URL=postgres://app_user:app_user_pw@localhost:54329/notes
# Used only by migrations/seed scripts (needs to create the role + tables).
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:54329/notes
# Password given to app_user when migrations run.
APP_DB_PASSWORD=app_user_pw
# 1 = the mock LLM returns malformed JSON on the first attempt of every summarize request.
MOCK_LLM_MALFORMED_ONCE=1

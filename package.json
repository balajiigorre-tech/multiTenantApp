{
  "name": "workspace-notes-app",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant workspaces > projects > notes app with Postgres row-level security",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:migrate": "tsx scripts/cli.ts migrate",
    "db:seed": "tsx scripts/cli.ts seed",
    "db:reset": "tsx scripts/cli.ts reset",
    "demo:db-attack": "tsx scripts/demo-direct-db.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/summary.test.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "next": "^15.1.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": { "node": ">=20" }
}
